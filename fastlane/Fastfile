# Mac olmadan imzalama: yalnızca GitHub Actions macOS runner'ında çalışır.
# Gizli bilgiler GitHub Secrets'tan ortam değişkeni olarak gelir.
default_platform(:ios)

APP_ID = "com.erdek.sehirrehberi.erdekrehberi"
WIDGET_ID = "#{APP_ID}.widget"

platform :ios do
  # App Store Connect API anahtarı (Apple ID / iki adımlı doğrulama gerekmez)
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      in_house: false
    )
  end

  desc "Dağıtım sertifikası + uygulama ve widget profillerini oluşturur (bir kez, ios-signing-setup)"
  lane :certificates do
    setup_ci
    match(
      type: "appstore",
      app_identifier: [APP_ID, WIDGET_ID],
      api_key: asc_api_key,
      readonly: false
    )
  end
end
